rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isOwner(userId) &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 256;
      allow update: if isOwner(userId) &&
        request.resource.data.id == request.auth.uid;
      allow delete: if false;
    }

    // Notes Collection
    match /notes/{noteId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(noteId) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 300;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Sheets Trackers Collection
    match /sheets_trackers/{trackerId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(trackerId) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 300;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Presentations Collection
    match /presentations/{presentationId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(presentationId) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 300;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Forms Survey Collection
    match /forms_surveys/{formId} {
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(formId) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 300;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
